{
  "name": "confitty",
  "version": "1.0.0",
  "private": true,
  "description": "Visual configuration builder for the Kitty terminal. Live preview, themes, smart diff export.",
  "homepage": "https://confitty.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/xcutiboo/Confitty.git"
  },
  "bugs": {
    "url": "https://github.com/xcutiboo/Confitty/issues"
  },
  "license": "MIT",
  "author": "xcutiboo",
  "keywords": [
    "kitty",
    "kitty-terminal",
    "kitty.conf",
    "terminal",
    "configuration",
    "config-generator",
    "angular",
    "themes"
  ],
  "scripts": {
    "start": "nx serve",
    "dev": "nx serve --configuration development",
    "build": "nx build --configuration production",
    "build:dev": "nx build --configuration development",
    "build:prod": "nx build --configuration production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@nx/angular": "22.6.4",
    "@nx/workspace": "22.6.4",
    "@schematics/angular": "^22.0.0",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.27",
    "nx": "22.6.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.11"
}