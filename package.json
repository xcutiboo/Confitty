{
	"name": "confitty",
	"version": "1.0.0",
	"private": true,
	"description": "Visual configuration builder for the Kitty terminal. Live preview, themes, smart diff export.",
	"homepage": "https://confitty.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/xcutiboo/Confitty.git"
	},
	"bugs": {
		"url": "https://github.com/xcutiboo/Confitty/issues"
	},
	"license": "MIT",
	"author": "xcutiboo",
	"keywords": [
		"kitty",
		"kitty-terminal",
		"kitty.conf",
		"terminal",
		"configuration",
		"config-generator",
		"angular",
		"themes"
	],
	"scripts": {
		"start": "nx serve",
		"dev": "nx serve --configuration development",
		"build": "nx build --configuration production",
		"build:dev": "nx build --configuration development",
		"build:prod": "nx build --configuration production",
		"typecheck": "tsc --noEmit",
		"postinstall": "sed -i 's/Your AI agent configuration is outdated. Run \"nx configure-ai-agents\" to update./ /g' node_modules/nx/src/tasks-runner/run-command.js || true"
	},
	"dependencies": {
		"@angular/common": "22.0.4",
		"@angular/compiler": "22.0.4",
		"@angular/core": "22.0.4",
		"@angular/forms": "22.0.4",
		"@angular/platform-browser": "22.0.4",
		"@angular/platform-browser-dynamic": "21.2.17",
		"@angular/router": "22.0.4",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.16.2"
	},
	"devDependencies": {
		"@angular-devkit/core": "22.0.4",
		"@angular-devkit/schematics": "22.0.4",
		"@angular/build": "22.0.4",
		"@angular/cli": "22.0.4",
		"@angular/compiler-cli": "22.0.4",
		"@nx/angular": "22.6.4",
		"@nx/workspace": "22.6.4",
		"@schematics/angular": "22.0.4",
		"@types/node": "25.9.4",
		"autoprefixer": "10.5.2",
		"nx": "22.6.4",
		"postcss": "8.5.15",
		"tailwindcss": "3.4.19",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.3.11"
}
