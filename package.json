{
	"name": "confitty",
	"version": "1.1.0",
	"private": true,
	"description": "Visual configuration builder for the Kitty terminal. Live preview, themes, smart diff export.",
	"homepage": "https://confitty.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/xcutiboo/Confitty.git"
	},
	"bugs": {
		"url": "https://github.com/xcutiboo/Confitty/issues"
	},
	"license": "MIT",
	"author": "xcutiboo",
	"keywords": [
		"kitty",
		"kitty-terminal",
		"kitty.conf",
		"terminal",
		"configuration",
		"config-generator",
		"angular",
		"themes"
	],
	"scripts": {
		"start": "nx serve",
		"dev": "nx serve --configuration development",
		"build": "nx build --configuration production",
		"build:dev": "nx build --configuration development",
		"build:prod": "nx build --configuration production",
		"test": "nx test",
		"test:watch": "nx test --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@angular/common": "21.2.19",
		"@angular/compiler": "21.2.19",
		"@angular/core": "21.2.19",
		"@angular/forms": "21.2.19",
		"@angular/platform-browser": "21.2.19",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular-devkit/core": "21.2.19",
		"@angular-devkit/schematics": "21.2.19",
		"@angular/build": "21.2.19",
		"@angular/cli": "21.2.19",
		"@angular/compiler-cli": "21.2.19",
		"@nx/angular": "22.7.7",
		"@nx/workspace": "22.7.7",
		"@schematics/angular": "21.2.19",
		"@types/node": "26.0.1",
		"autoprefixer": "10.5.2",
		"jsdom": "^26",
		"nx": "22.7.7",
		"postcss": "8.5.23",
		"semantic-release": "25.0.5",
		"tailwindcss": "3.4.19",
		"typescript": "6.0.3",
		"vitest": "^4"
	},
	"packageManager": "bun@1.3.11",
	"overrides": {
		"undici": "7.29.0",
		"form-data": "4.0.6",
		"qs": "6.15.2",
		"@hono/node-server": "1.19.15",
		"http-proxy-middleware": "3.0.7"
	},
	"release": {
		"branches": [
			"confitty"
		]
	}
}
