# Cloudflare Pages and Workers both read this file from the build output.
# Pages allows 100 rules, each header up to 2000 characters.
#
# Permissions-Policy denies the hardware APIs the app never touches. It used to
# carry interest-cohort, which stopped meaning anything when FLoC was abandoned.
# The ad-measurement directives are deliberately not denied: the site serves
# AdSense, and blocking the APIs it runs on would cost revenue for no privacy
# gain that matters here, since nothing about your config is ever sent anywhere.
#
# Google supports only a nonce-based policy for AdSense and says plainly that
# the domains its ad code calls change without notice. A nonce needs a value
# per response, which a static site served straight from the edge does not have,
# and the policy Google publishes to go with it allows scripts from any https
# origin. That is a worse trade for an editor that parses files people paste in,
# so the allowlist stays and the reporting endpoint below covers the risk it
# carries: nothing at all said that ep1 was being blocked.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), midi=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Reporting-Endpoints: csp="https://confitty.app/api/csp-report"
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://storage.ko-fi.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://fundingchoicesmessages.google.com https://fundingchoices.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://ep1.adtrafficquality.google https://cloudflareinsights.com https://fundingchoicesmessages.google.com; font-src 'self' https://fonts.gstatic.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://ep2.adtrafficquality.google https://fundingchoicesmessages.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report; report-to csp

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/manifest.json
